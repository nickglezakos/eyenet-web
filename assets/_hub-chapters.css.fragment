/* ===== HUB USE-CASE CHAPTERS ===== */
.hub-cases-intro {
  padding-bottom: 3.5rem;
}
.hub-entries {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.hub-entry {
  --hub-accent: #22d3ee;
  --hub-wash: rgba(34, 211, 238, 0.07);
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  text-decoration: none;
  color: inherit;
  background: #050505;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  min-height: clamp(420px, 72vh, 720px);
  isolation: isolate;
  transition: background 0.35s ease;
}
.hub-entry + .hub-entry {
  margin-top: 1.75rem;
  box-shadow: 0 -1.75rem 0 #000;
}
.hub-entry:hover {
  background: #080808;
}
.hub-entry--flip {
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
}
.hub-entry--flip .hub-entry-media {
  order: 2;
}
.hub-entry--flip .hub-entry-copy {
  order: 1;
}

/* Per-case accent so chapters read as separate worlds */
.hub-entry--presence { --hub-accent: #22d3ee; --hub-wash: rgba(34, 211, 238, 0.08); }
.hub-entry--signage  { --hub-accent: #67e8f9; --hub-wash: rgba(103, 232, 249, 0.07); }
.hub-entry--shop     { --hub-accent: #2dd4bf; --hub-wash: rgba(45, 212, 191, 0.08); }
.hub-entry--home     { --hub-accent: #38bdf8; --hub-wash: rgba(56, 189, 248, 0.08); }
.hub-entry--care     { --hub-accent: #5eead4; --hub-wash: rgba(94, 234, 212, 0.08); }
.hub-entry--security { --hub-accent: #94a3b8; --hub-wash: rgba(148, 163, 184, 0.08); }
.hub-entry--shipping { --hub-accent: #38bdf8; --hub-wash: rgba(14, 165, 233, 0.1); }

.hub-entry-media {
  position: relative;
  overflow: hidden;
  min-height: 280px;
  background: #0a0a0a;
}
.hub-entry-media::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    linear-gradient(to top, rgba(0, 0, 0, 0.35), transparent 42%),
    var(--hub-wash);
  mix-blend-mode: normal;
}
.hub-entry-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: grayscale(0.35) brightness(0.72) contrast(1.12) saturate(0.85);
  transition: transform 0.7s ease, filter 0.45s ease;
}
.hub-entry:hover .hub-entry-media img {
  transform: scale(1.045);
  filter: grayscale(0.12) brightness(0.86) contrast(1.14) saturate(1);
}

.hub-entry-copy {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0.85rem;
  padding: clamp(2rem, 4vw, 3.75rem) clamp(1.5rem, 4vw, 3.5rem);
  border-left: 1px solid rgba(255, 255, 255, 0.08);
  background:
    linear-gradient(165deg, rgba(255, 255, 255, 0.03), transparent 42%),
    #050505;
}
.hub-entry--flip .hub-entry-copy {
  border-left: 0;
  border-right: 1px solid rgba(255, 255, 255, 0.08);
}
.hub-entry-copy::before {
  content: '';
  position: absolute;
  top: clamp(2rem, 4vw, 3.75rem);
  left: 0;
  width: 3px;
  height: 3.5rem;
  background: var(--hub-accent);
}
.hub-entry--flip .hub-entry-copy::before {
  left: auto;
  right: 0;
}

.hub-entry-meta {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  flex-wrap: wrap;
}
.hub-entry-num {
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--hub-accent);
}
.hub-entry-domain {
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.78);
  padding: 0.35rem 0.65rem;
  border: 1px solid rgba(255, 255, 255, 0.14);
  background: rgba(255, 255, 255, 0.03);
}
.hub-entry-audience {
  font-size: 0.78rem;
  font-weight: 400;
  letter-spacing: 0.04em;
  color: rgba(255, 255, 255, 0.42);
  line-height: 1.4;
  max-width: 34rem;
}
.hub-entry-title {
  font-size: clamp(1.55rem, 3.1vw, 2.55rem);
  font-weight: 900;
  letter-spacing: -0.035em;
  line-height: 1.05;
  color: #fff;
  max-width: 18ch;
}
.hub-entry-title em {
  font-style: normal;
  color: var(--hub-accent);
}
.hub-entry-tease {
  font-size: 1rem;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.62);
  line-height: 1.55;
  max-width: 36rem;
}
.hub-entry-points {
  list-style: none;
  display: grid;
  gap: 0.45rem;
  margin: 0.35rem 0 0.25rem;
  padding: 0;
}
.hub-entry-points li {
  position: relative;
  padding-left: 1.1rem;
  font-size: 0.88rem;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.35;
}
.hub-entry-points li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.45em;
  width: 0.4rem;
  height: 0.4rem;
  background: var(--hub-accent);
}
.hub-entry-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;
  margin-top: 0.85rem;
  width: fit-content;
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--hub-accent);
  letter-spacing: -0.01em;
  border-bottom: 1px solid transparent;
  transition: border-color 0.25s ease, gap 0.25s ease;
}
.hub-entry-cta::after {
  content: '→';
  transition: transform 0.25s ease;
}
.hub-entry:hover .hub-entry-cta {
  border-bottom-color: var(--hub-accent);
  gap: 0.85rem;
}
.hub-entry:hover .hub-entry-cta::after {
  transform: translateX(3px);
}
.hub-entry:focus-visible {
  outline: 2px solid var(--hub-accent);
  outline-offset: -2px;
}
.close-cta-panel {
  text-align: center; padding: 6rem 2rem;
}
.close-cta-panel .cta-row {
  display: flex; flex-wrap: wrap; gap: 2rem; justify-content: center; margin-top: 2.5rem;
}
.cta-pair {
  margin-top: 2rem;
  display: flex; flex-wrap: wrap; gap: 1.75rem 2.5rem;
  justify-content: center; align-items: center;
}
.cta-pair .cta-link { font-size: 1.05rem; }
.cta-link-case { color: #67e8f9; }
.cta-link-case::after { background: #67e8f9; }

/* Sticky FAB — product ↔ use cases */
.site-fab {
  position: fixed; z-index: 40;
  right: 1.25rem; bottom: 1.25rem;
  display: flex; flex-direction: column; gap: 0.55rem;
  align-items: flex-end;
}
.site-fab a {
  display: inline-flex; align-items: center; gap: 0.45rem;
  padding: 0.7rem 1.05rem;
  font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em;
  text-transform: uppercase; text-decoration: none;
  border: 1px solid rgba(34, 211, 238, 0.45);
  background: rgba(0, 0, 0, 0.88);
  backdrop-filter: blur(10px);
  color: #22d3ee;
  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
  transition: border-color 0.2s ease, background 0.2s ease, color 0.2s ease;
}
.site-fab a:hover {
  border-color: #22d3ee;
  background: rgba(8, 20, 28, 0.96);
  color: #fff;
}
.site-fab a.site-fab-primary {
  background: #0891b2;
  border-color: #22d3ee;
  color: #041018;
}
.site-fab a.site-fab-primary:hover {
  background: #22d3ee;
  color: #000;
}
@media (max-width: 500px) {
  .site-fab { right: 0.75rem; bottom: 0.75rem; }
  .site-fab a { padding: 0.6rem 0.85rem; font-size: 0.65rem; }
}

.close-cta-panel {
  text-align: center; padding: 6rem 2rem;
}
.close-cta-panel .cta-row {
  display: flex; flex-wrap: wrap; gap: 2rem; justify-content: center; margin-top: 2.5rem;
}
